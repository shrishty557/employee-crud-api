# Change this to the exact Server name shown in SSMS if different.
DB_SERVER=localhost\SQLEXPRESS
DB_NAME=EmployeeApiDB
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_TRUSTED_CONNECTION=yes
# Windows authentication is used when DB_TRUSTED_CONNECTION=yes.
# For SQL authentication instead, set DB_TRUSTED_CONNECTION=no and fill these:
DB_USERNAME=
DB_PASSWORD=
